    "direction": "multiple",
    "one_line_summary": "RC-aux让潜世界模型从可预测走向可规划",
    "tags": [
      "Code",
      "Academic",
      "🟢 Code",
      "🔥 Hot"
    ],
    "affiliation_tier": 0,
    "affiliation_names": [],
    "scores": {
