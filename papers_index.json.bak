    "selected_figures": [
      {
        "filename": "figure-005-framework-v1.png",
        "priority": "high",
        "reason": "这是论文核心方法架构图，清晰展示了 Full Path（VLM+AE）与 Flash Path（Draft+Verify）的双路径设计，以及 Draft Model 的内部结构（Gemma Block + Action Linear），是理解 FLASH 框架的关键。",
        "description": "Realtime-VLA FLASH 框架总览与 Draft Model 内部结构",
        "suggested_section": "方法与公式"
      },
      {
        "filename": "figure-001-overview-wo-title.png",
        "priority": "high",
        "reason": "左侧通过时间线直观对比了同步推理（失败）与 FLASH（成功）的帧级差异，右侧图解了 Speculative Inference 的 Draft-Verify-Accept 流程，是论文核心 Insight 的浓缩展示。",
        "description": "同步推理与 FLASH 的时间线对比及推测推理流程示意",
        "suggested_section": "核心 Insight"
      },
      {
        "filename": "figure-002-action-visualization.png",
        "priority": "high",
        "reason": "以 3D 轨迹可视化直接揭示了 Naive Speculative Inference 的失败原因（Fine Adjustment 阶段偏差导致 Task Failure），以及 Phase-Aware Fallback 如何通过回退到 Full Path 保证 Task Success，是支撑核心算法贡献的直观证据。",
        "description": "Naive 推测推理与 Phase-Aware Fallback 的 3D 轨迹对比",
        "suggested_section": "核心 Insight"
      },
      {
        "filename": "figure-000-conveyor-demo.png",
        "priority": "medium",
        "reason": "展示了真实世界传送带分拣任务中 JAX（失败）与 FLASH+Triton（成功）的对比，覆盖玩具狗和梳子两个实例，直接验证了论文方法在延迟敏感的真实场景中的有效性。",
        "description": "真实世界传送带分拣任务中基线与 FLASH 的定性结果对比",
        "suggested_section": "实验与消融"
      }
    ],
    "rich_reading_generated_at": "2026-05-14T08:38:11.229216+00:00"
